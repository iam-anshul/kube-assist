# Copy to .env and fill in real values. Never commit .env.

# HTTP Basic auth guarding /docs and /openapi.json.
# Required - the app refuses to start without these.
DOCS_USERNAME=
DOCS_PASSWORD=

# SuperTokens auth service
SUPERTOKENS_CONNECTION_URL=
SUPERTOKENS_API_KEY=

# Database
DATABASE_CONNECTION_STRING=

# Model providers
ANTHRIPIC_API_KEY=
OPENAI_KEY=
OPENAI_BASE_URL=
